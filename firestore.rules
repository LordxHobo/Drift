rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Profiles: anyone signed in to Drift can see them (needed for search and friends),
    // only the owner can create, change or delete their own.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.usernameLower is string
        && get(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;

      // Your synced library (all playlists, liked songs, followed artists): only you.
      match /library/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Playlists shown on a profile: anyone signed in can see them, only the owner can change them.
      match /playlists/{playlistId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Linking a computer: the computer posts a one-time code with its public key, your phone answers
    // with your sign-in encrypted for that computer only. Codes can't be listed, only looked up.
    match /pairings/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['owner', 'desktopKey', 'device', 'createdAt'])
        && code.matches('^[A-Z2-9]{8}$');
      allow update: if request.auth != null
        && request.auth.uid != resource.data.owner
        && !('box' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phoneKey', 'box']);
      allow delete: if request.auth != null && request.auth.uid == resource.data.owner;
    }

    // Collaborative playlists: only members can see one. Members can change its songs and name;
    // only the owner changes who's in it (a member can still take themselves out), or deletes it.
    match /collabs/{id} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.auth.uid in request.resource.data.members;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.members
        && request.resource.data.owner == resource.data.owner
        && (request.auth.uid == resource.data.owner
            || request.resource.data.members == resource.data.members
            || request.resource.data.members.toSet() == resource.data.members.toSet().difference([request.auth.uid].toSet()));
      allow delete: if request.auth != null && request.auth.uid == resource.data.owner;
    }

    // Usernames: one owner each, first come first served.
    match /usernames/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && name.matches('^[a-z0-9_.]{3,20}$');
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
