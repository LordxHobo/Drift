rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Profiles: anyone signed in to Drift can see them (needed for search and friends),
    // only the owner can create, change or delete their own.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.usernameLower is string
        && get(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;

      // Your synced library (all playlists, liked songs, followed artists): only you.
      match /library/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Playlists shown on a profile: anyone signed in can see them, only the owner can change them.
      match /playlists/{playlistId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      // Listen Together invites to you, one per friend (the document is named after them). Only friends
      // who follow each other can invite, and only when you allow invites. You read and clear yours;
      // the one who invited you can take theirs back.
      match /invites/{from} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow delete: if request.auth != null && (request.auth.uid == uid || request.auth.uid == from);
        allow create, update: if request.auth != null
          && request.auth.uid == from
          && from != uid
          && request.resource.data.from == from
          && request.resource.data.code is string
          && request.resource.data.keys().hasOnly(['from', 'fromName', 'code', 'title', 'artist', 'at'])
          && get(/databases/$(database)/documents/users/$(uid)).data.following.hasAny([from])
          && get(/databases/$(database)/documents/users/$(from)).data.following.hasAny([uid])
          && get(/databases/$(database)/documents/users/$(uid)).data.get('allowInvites', true) != false;
      }
    }

    // Linking a computer: the computer posts a one-time code with its public key, your phone answers
    // with your sign-in encrypted for that computer only. Codes can't be listed, only looked up.
    match /pairings/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['owner', 'desktopKey', 'device', 'createdAt'])
        && code.matches('^[A-Z2-9]{8}$');
      allow update: if request.auth != null
        && request.auth.uid != resource.data.owner
        && !('box' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phoneKey', 'box']);
      allow delete: if request.auth != null && request.auth.uid == resource.data.owner;
    }

    // Collaborative playlists: only members can see one. Members can change its songs and name;
    // only the owner changes who's in it (a member can still take themselves out), or deletes it.
    match /collabs/{id} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.auth.uid in request.resource.data.members;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.members
        && request.resource.data.owner == resource.data.owner
        && (request.auth.uid == resource.data.owner
            || request.resource.data.members == resource.data.members
            || request.resource.data.members.toSet() == resource.data.members.toSet().difference([request.auth.uid].toSet()));
      allow delete: if request.auth != null && request.auth.uid == resource.data.owner;
    }

    // Listen Together: a session is looked up by its code (not listed). Members change what plays;
    // anyone signed in can add themselves (joining with the code); only the host ends it.
    match /jams/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.host == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && code.matches('^[A-Z2-9]{6}$');
      allow update: if request.auth != null
        && request.resource.data.host == resource.data.host
        && (request.auth.uid in resource.data.members
            || (request.resource.data.members.toSet() == resource.data.members.toSet().union([request.auth.uid].toSet())
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names'])));
      allow delete: if request.auth != null && request.auth.uid == resource.data.host;
    }

    // Usernames: one owner each, first come first served.
    match /usernames/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && name.matches('^[a-z0-9_.]{3,20}$');
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
