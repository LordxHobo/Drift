rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Profiles: anyone signed in to Drift can see them (needed for search and friends),
    // only the owner can create, change or delete their own.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.usernameLower is string
        && get(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Usernames: one owner each, first come first served.
    match /usernames/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && name.matches('^[a-z0-9_.]{3,20}$');
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
